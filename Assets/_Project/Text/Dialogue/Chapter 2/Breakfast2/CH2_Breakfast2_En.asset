  m_Name: CH2_Breakfast2_En
  m_EditorClassIdentifier: Assembly-CSharp::Game.Localization.LocalizationDatabase
  entries:
  - Key: CH2_Breakfast2_01
    Value: "Isn\u2019t Rara coming home today?"
  - Key: CH2_Breakfast2_02
    Value: "Yeah. Actually, she really likes staying at Grandpa\u2019s."
  - Key: CH2_Breakfast2_03
    Value: But her school break is almost over.
  - Key: CH2_Breakfast2_04
    Value: And I really miss my little girl, too.
  - Key: CH2_Breakfast2_05
    Value: Me too. I think everyone loves her.
  - Key: CH2_Breakfast2_06
    Value: "She\u2019s such a sweet kid."
  - Key: CH2_Breakfast2_07
    Value: "Oh, right. I can\u2019t pick Rara up today."
  - Key: CH2_Breakfast2_08
    Value: "I\u2019ve got a lot of work to finish today."
  - Key: CH2_Breakfast2_09
    Value: Can you pick Rara up this afternoon?
  - Key: CH2_Breakfast2_Agree
    Value: "Okay, I\u2019ll pick her up"
