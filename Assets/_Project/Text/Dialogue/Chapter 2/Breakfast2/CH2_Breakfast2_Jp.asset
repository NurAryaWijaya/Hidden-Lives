  entries:
  - Key: CH2_Breakfast2_01
    Value: "\u4ECA\u65E5\u3001\u30E9\u30E9\u304C\u5E30\u3063\u3066\u304F\u308B\u3093\u3058\u3083\u306A\u304B\u3063\u305F\u3063\u3051\uFF1F"
  - Key: CH2_Breakfast2_02
    Value: "\u3046\u3093\u3002\u5B9F\u306F\u3001\u304A\u3058\u3044\u3061\u3083\u3093\u306E\u5BB6\u304C\u3059\u3054\u304F\u6C17\u306B\u5165\u3063\u3066\u308B\u307F\u305F\u3044\u3002"
  - Key: CH2_Breakfast2_03
    Value: "\u3067\u3082\u3001\u5B66\u6821\u306E\u4F11\u307F\u3082\u3082\u3046\u3059\u3050\u7D42\u308F\u308B\u304B\u3089\u3002"
  - Key: CH2_Breakfast2_04
    Value: "\u305D\u308C\u306B\u3001\u79C1\u3082\u3042\u306E\u5B50\u306B\u3059\u3054\u304F\u4F1A\u3044\u305F\u3044\u3057\u3002"
  - Key: CH2_Breakfast2_05
    Value: "\u4FFA\u3082\u3002\u307F\u3093\u306A\u3001\u3042\u306E\u5B50\u306E\u3053\u3068\u597D\u304D\u3060\u3088\u306D\u3002"
  - Key: CH2_Breakfast2_06
    Value: "\u3059\u3054\u304F\u3044\u3044\u5B50\u3060\u3082\u3093\u306A\u3002"
  - Key: CH2_Breakfast2_07
    Value: "\u3042\u3001\u305D\u3046\u3060\u3002\u4ECA\u65E5\u306F\u30E9\u30E9\u3092\u8FCE\u3048\u306B\u884C\u3051\u306A\u3044\u306E\u3002"
  - Key: CH2_Breakfast2_08
    Value: "\u4ECA\u65E5\u3001\u7D42\u308F\u3089\u305B\u306A\u3044\u3068\u3044\u3051\u306A\u3044\u4ED5\u4E8B\u304C\u305F\u304F\u3055\u3093\u3042\u3063\u3066\u3002"
  - Key: CH2_Breakfast2_09
    Value: "\u4ECA\u65E5\u306E\u5915\u65B9\u3001\u30E9\u30E9\u3092\u8FCE\u3048\u306B\u884C\u3063\u3066\u304F\u308C\u308B\uFF1F"
  - Key: CH2_Breakfast2_Agree
    Value: "\u8FCE\u3048\u306B\u884C\u304F"
