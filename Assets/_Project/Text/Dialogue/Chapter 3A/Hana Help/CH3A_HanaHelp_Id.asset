  m_Script: {fileID: 11500000, guid: 53c49e862dc531140a76938cc94fa805, type: 3}
  m_Name: CH3A_HanaHelp_Id
  m_EditorClassIdentifier: Assembly-CSharp::Game.Localization.LocalizationDatabase
  entries:
  - Key: CH3A_HanaHelp_01
    Value: Reno...
  - Key: CH3A_HanaHelp_02
    Value: Ada beberapa masalah dalam komputerku.
  - Key: CH3A_HanaHelp_03
    Value: Bisakah kamu membantuku?
  - Key: CH3A_HanaHelp_04
    Value: Tentu.
  - Key: CH3A_HanaHelp_05
    Value: Makasih ya untuk bantuannya hari ini.
  - Key: CH3A_HanaHelp_06
    Value: Iya, sama-sama.
  - Key: CH3A_HanaHelp_07
    Value: 'Sebagai gantinya, gimana kalau aku teraktir makan malam? '
  - Key: CH3A_HanaHelp_08
    Value: Nggak usah.
  - Key: CH3A_HanaHelp_09
    Value: Kenapa?
  - Key: CH3A_HanaHelp_10
    Value: Gakpapa, Aku bantu kamu karena memang perlu dibantu aja.
  - Key: CH3A_HanaHelp_11
    Value: Ayolah... atau kamu berusaha menghindari ku?
  - Key: CH3A_HanaHelp_12
    Value: Bukan begitu...
  - Key: CH3A_HanaHelp_13
    Value: Lalu kenapa?
  - Key: CH3A_HanaHelp_14
    Value: Hari ini aku harus jemput anaku dari rumah kakeknya.
  - Key: CH3A_HanaHelp_15
    Value: Kamu sudah punya anak?
  - Key: CH3A_HanaHelp_16
    Value: Ya.
  - Key: CH3A_HanaHelp_17
    Value: wahh.. keluarga memang harus jadi prioritas.
  - Key: CH3A_HanaHelp_18
    Value: Kalau gitu lain kali aja teraktirnya.
  - Key: CH3A_HanaHelp_19
    Value: Oke, sampai jumpa
  - Key: CH3A_HanaHelp_20
    Value: 'Okedeh, kamu yang tentukan tempatnya. '
  - Key: CH3A_HanaHelp_21
    Value: Siipp...
