  m_Script: {fileID: 11500000, guid: 53c49e862dc531140a76938cc94fa805, type: 3}
  m_Name: CH3A_HanaCafe_Id
  m_EditorClassIdentifier: Assembly-CSharp::Game.Localization.LocalizationDatabase
  entries:
  - Key: 1
    Value: Gimana kabar kamu?
  - Key: 2
    Value: Baik, kamu sendiri gimana?
  - Key: 3
    Value: Aku juga baik.
  - Key: 4
    Value: Bukankah kamu sedang pendidikan di luar negeri?
  - Key: 5
    Value: Aku sudah lulus beberapa tahun yang lalu.
  - Key: 6
    Value: Oh iya kah? Waktu berjalan sangat cepat.
  - Key: 7
    Value: Iya, nggak kerasa. Rasanya baru kemarin aku pamit sama kamu.
  - Key: 8
    Value: Waktu itu kamu bilang cuma pergi sebentar.
  - Key: 9
    Value: Ternyata sebentarnya lama.
  - Key: 10
    Value: Tapi kamu akhirnya balik juga.
  - Key: 11
    Value: Iya. Kadang aku juga masih kangen suasana di sini.
  - Key: 12
    Value: 'Atau mungkin ada kenangan tertentu yang bikin kamu kangen? '
  - Key: 13
    Value: Mungkin ada. Tapi nggak semuanya harus diingat, kan?
  - Key: 14
    Value: Iya, mungkin begitu.
  - Key: 15
    Value: Setelah dua jam
  - Key: 16
    Value: Kayaknya aku harus pergi dulu.
  - Key: 17
    Value: Ada urusan?
  - Key: 18
    Value: Iya, proyek baru bos. Aku harus mengejar tenggat waktunya
  - Key: 19
    Value: Oh, arena wahana baru itu?
  - Key: 20
    Value: Iya.
  - Key: 21
    Value: Jadi kamu yang menangani proyek itu.
  - Key: 22
    Value: Kapan kamu mulai mengecek area itu?
  - Key: 23
    Value: Besok.
  - Key: 24
    Value: Besok?? bukankah besok weekend?
  - Key: 25
    Value: Yah.. mau gimana lagi, tenggat waktunya sudah mepet banget
  - Key: 26
    Value: Kalau butuh bantuan, hubungi aku saja
  - Key: 27
    Value: Oke...
