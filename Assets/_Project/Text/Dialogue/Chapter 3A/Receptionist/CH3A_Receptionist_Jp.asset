  - nodeID: CH3A_Receptionist_05
    speakerName: "\u53D7\u4ED8"
    dialogueText: "\u3048\u3048\u2026\u2026\u5148\u9031\u306F\u3051\u3063\u3053\u3046\u6B8B\u696D\u3057\u3066\u307E\u3057\u305F\u3088\u306D\u3002"
    nextNodeIndex: 5
  - nodeID: CH3A_Receptionist_06
    speakerName: Reno
    dialogueText: "\u305D\u3046\u3060\u306D\u3002"
    nextNodeIndex: 6
  - nodeID: CH3A_Receptionist_07
    speakerName: "\u53D7\u4ED8"
    dialogueText: "\u3067\u3082\u3001\u6B8B\u696D\u4EE3\u304C\u3061\u3083\u3093\u3068\u5165\u3063\u3066\u304F\u308B\u306A\u3089\u3001\u307E\u3042\u5B89\u5FC3\u3067\u3059\u3088\u306D\u3002"
    nextNodeIndex: 7
  - nodeID: CH3A_Receptionist_08
    speakerName: Reno
    dialogueText: "\u305D\u3046\u3001\u305D\u308C\u304C\u4E00\u756A\u5927\u4E8B\u306A\u3093\u3060\u3088\u3001\u306F\u306F\u306F\u2026\u2026\u3002"
    nextNodeIndex: 8
  - nodeID: CH3A_Receptionist_09
    speakerName: "\u53D7\u4ED8"
    dialogueText: "\u305D\u3046\u3044\u3048\u3070\u3001\u793E\u9577\u304C\u4F5C\u3089\u305B\u3066\u3044\u305F\u65B0\u3057\u3044\u30A2\u30C8\u30E9\u30AF\u30B7\u30E7\u30F3\u30A8\u30EA\u30A2\u306F\u3001\u3082\u3046\u5B8C\u6210\u3057\u305F\u3093\u3067\u3059\u304B\uFF1F"
    nextNodeIndex: 9
  - nodeID: CH3A_Receptionist_10
    speakerName: Reno
    dialogueText: "\u305F\u3076\u3093\u306D\u3002\u6628\u65E5\u3001\u305D\u306E\u4EF6\u306B\u3064\u3044\u3066\u306E\u4F1A\u8B70\u304C\u3042\u3063\u305F\u304B\u3089\u3002"
    nextNodeIndex: 10
  - nodeID: CH3A_Receptionist_11
    speakerName: "\u53D7\u4ED8"
    dialogueText: "\u305D\u308C\u3067\u3001\u305D\u306E\u30A2\u30C8\u30E9\u30AF\u30B7\u30E7\u30F3\u306E\u30D7\u30ED\u30B8\u30A7\u30AF\u30C8\u306F\u3069\u306E\u30C1\u30FC\u30E0\u304C\u5F15\u304D\u7D99\u3050\u3093\u3067\u3059\u304B\uFF1F"
    nextNodeIndex: 11
  - nodeID: CH3A_Receptionist_12
    speakerName: Reno
    dialogueText: "\u3055\u3042\u306D\u3002\u65B0\u3057\u3044\u30C1\u30FC\u30E0\u3092\u4F5C\u308B\u307F\u305F\u3044\u3060\u3088\u3002"
    nextNodeIndex: 12
  - nodeID: CH3A_Receptionist_13
    speakerName: "\u53D7\u4ED8"
    dialogueText: "\u3042\u3042\u2026\u2026\u306A\u308B\u307B\u3069\u3002\u3060\u304B\u3089\u4ECA\u65E5\u306F\u3082\u3046\u65B0\u3057\u3044\u793E\u54E1\u304C\u3044\u308B\u3093\u3067\u3059\u306D\u3002"
    nextNodeIndex: 13
  - nodeID: CH3A_Receptionist_14
