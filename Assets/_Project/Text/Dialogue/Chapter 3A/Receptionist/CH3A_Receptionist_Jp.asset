  - nodeID: CH3A_Receptionist_03
    speakerName: "\u53D7\u4ED8"
    dialogueText: "\u30D7\u30ED\u30B8\u30A7\u30AF\u30C8\u306E\u307B\u3046\u306F\u3069\u3046\u3067\u3059\u304B\uFF1F\u9806\u8ABF\u3067\u3059\u304B\uFF1F"
    nextNodeIndex: 3
  - nodeID: CH3A_Receptionist_04
    speakerName: Reno
    dialogueText: "\u3046\u30FC\u3093\u2026\u2026\u307E\u3060\u3044\u304F\u3064\u304B\u554F\u984C\u304C\u3042\u308B\u3088\u3002"
