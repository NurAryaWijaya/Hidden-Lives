  - nodeID: CH3A_Receptionist_17
    speakerName: Reno
    dialogueText: "\u305D\u3046\u3060\u308D\u3046\u306D\u3002\u65B0\u3057\u3044\u30A2\u30C8\u30E9\u30AF\u30B7\u30E7\u30F3\u306F\u3001\u30AA\u30FC\u30D7\u30F3\u3059\u308B\u524D\u306B\u54C1\u8CEA\u3092\u30C1\u30A7\u30C3\u30AF\u3059\u308B\u5FC5\u8981\u304C\u3042\u308B\u304B\u3089\u3002"
    nextNodeIndex: 17
