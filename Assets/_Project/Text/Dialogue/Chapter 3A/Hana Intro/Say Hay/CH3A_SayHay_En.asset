  m_Script: {fileID: 11500000, guid: 53c49e862dc531140a76938cc94fa805, type: 3}
  m_Name: CH3A_SayHay_En
  m_EditorClassIdentifier: Assembly-CSharp::Game.Localization.LocalizationDatabase
  entries:
  - Key: CH3A_SayHay_01
    Value: Good morning.
  - Key: CH3A_SayHay_02
    Value: Oh... Good morning.
  - Key: CH3A_SayHay_03
    Value: Hana???
  - Key: CH3A_SayHay_04
    Value: (She's my ex-girlfriend.)
  - Key: CH3A_SayHay_05
    Value: Reno? Long time no see.
  - Key: CH3A_SayHay_06
    Value: Yeah. How have you been?
  - Key: CH3A_SayHay_07
    Value: I'm good. Do you work here too?
  - Key: CH3A_SayHay_08
    Value: Yeah...
  - Key: CH3A_SayHay_09
    Value: (The atmosphere becomes awkward.)
  - Key: CH3A_SayHay_10
    Value: Well then, I'll head to my desk.
  - Key: CH3A_SayHay_11
    Value: Oh, okay. See you.
