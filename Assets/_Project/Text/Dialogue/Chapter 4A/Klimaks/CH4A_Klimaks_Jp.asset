  - Key: 4
    Value: "\u3042\u306E\u5973\u306E\u3053\u3068\u3088\u3002\u6700\u8FD1\u3001\u3042\u306A\u305F\u304C\u4F55\u3092\u3057\u3066\u308B\u304B\u3001\u5168\u90E8\u77E5\u3063\u3066\u308B\u3002"
  - Key: 5
    Value: "\u307E\u3055\u304B\u3001\u4FFA\u306E\u3053\u3068\u3092\u5C3E\u3051\u3066\u305F\u306E\u304B\uFF1F"
  - Key: 6
    Value: "\u79C1\u306F\u3042\u306A\u305F\u306E\u59BB\u3088\u3001Reno\uFF01\u3000\u3069\u3046\u3057\u3066\u3042\u306A\u305F\u304C\u5909\u308F\u3063\u3066\u3057\u307E\u3063\u305F\u306E\u304B\u3001\u305D\u308C\u3092\u77E5\u308A\u305F\u3044\u3060\u3051\u306A\u306E\uFF01"
  - Key: 7
    Value: "\u3082\u3046\u75B2\u308C\u305F\u3093\u3060\u3088\uFF01\u3000\u5BB6\u306B\u5E30\u308B\u305F\u3073\u3001\u4F55\u3082\u304B\u3082\u4FFA\u304C\u60AA\u3044\u307F\u305F\u3044\u306B\u8CAC\u3081\u3089\u308C\u308B\u306E\u306B\u306F\u3001\u3082\u3046\u3046\u3093\u3056\u308A\u3060\uFF01"
  - Key: 8
    Value: "\u3060\u304B\u3089\u6D6E\u6C17\u3057\u305F\u3063\u3066\u3044\u3046\u306E\uFF1F"
  - Key: 9
    Value: "\u4F55\u3082\u304B\u3082\u4FFA\u306E\u305B\u3044\u307F\u305F\u3044\u306B\u8A00\u3046\u306A\u3088\uFF01"
  - Key: 10
    Value: "\u3058\u3083\u3042\u8AB0\u306E\u305B\u3044\u306A\u306E\uFF1F\u3000\u79C1\u306F\u307E\u3060\u3053\u3053\u306B\u3044\u308B\u3002Reno\u3001\u4ECA\u3067\u3082\u3053\u306E\u5BB6\u65CF\u3092\u5B88\u308D\u3046\u3068\u3057\u3066\u308B\u306E\u3088\uFF01"
  - Key: 11
    Value: "\u4FFA\u3060\u3063\u3066\u9811\u5F35\u3063\u305F\u3093\u3060\uFF01\u3000\u3067\u3082\u3001\u304A\u524D\u306F\u4E00\u5EA6\u3082\u4FFA\u306E\u3053\u3068\u3092\u3061\u3083\u3093\u3068\u898B\u3066\u304F\u308C\u306A\u304B\u3063\u305F\uFF01"
  - Key: 12
    Value: "\u5C11\u306A\u304F\u3068\u3082\u3001\u79C1\u306F\u3042\u306A\u305F\u3092\u88CF\u5207\u3063\u305F\u3053\u3068\u306A\u3093\u3066\u306A\u3044\uFF01"
  - Key: 13
