--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 53c49e862dc531140a76938cc94fa805, type: 3}
  m_Name: CH4A_Klimaks_Id
  m_EditorClassIdentifier: Assembly-CSharp::Game.Localization.LocalizationDatabase
  entries:
  - Key: 1
    Value: Setelah dua bulan
  - Key: 2
    Value: Kamu pikir aku nggak tahu?
  - Key: 3
    Value: Tahu apa?
  - Key: 4
    Value: Tentang dia. Tentang semua yang kamu lakukan belakangan ini.
  - Key: 5
    Value: Jadi sekarang kamu ngikutin aku?
  - Key: 6
    Value: Aku istrimu, Reno! Aku cuma mau tahu kenapa suamiku berubah!
  - Key: 7
    Value: Karena aku capek! Capek pulang ke rumah dan selalu merasa disalahkan!
  - Key: 8
    Value: Jadi itu alasan kamu selingkuh?
  - Key: 9
    Value: 'Jangan seolah-olah semuanya cuma salahku! '
  - Key: 10
    Value: Memangnya salah siapa? Aku masih di sini, Reno. Aku masih berusaha mempertahankan
      keluarga ini!
  - Key: 11
    Value: Dan aku juga pernah berusaha! Tapi kamu nggak pernah benar-benar melihat
      aku!
  - Key: 12
    Value: Setidaknya aku nggak pernah mengkhianati kamu!
  - Key: 13
    Value: Cukup!
  - Key: 14
    Value: Kenapa? Sakit dengarnya? Memang begitu kenyataannya!
  - Key: End1
    Value: Korban
  - Key: End2
    Value: Tak Bersalah
