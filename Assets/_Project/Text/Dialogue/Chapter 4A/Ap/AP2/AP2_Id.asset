--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 53c49e862dc531140a76938cc94fa805, type: 3}
  m_Name: AP2_Id
  m_EditorClassIdentifier: Assembly-CSharp::Game.Localization.LocalizationDatabase
  entries:
  - Key: 1
    Value: Ternyata masih seru.
  - Key: 2
    Value: Dulu kamu juga paling semangat kalau diajak ke tempat seperti ini.
  - Key: 3
    Value: Tapi rasanya agak aneh.
  - Key: 4
    Value: Kenapa?
  - Key: 5
    Value: Kita bisa ketawa seperti dulu lagi.
  - Key: 6
    Value: Aku juga sempat lupa rasanya.
  - Key: 7
    Value: Kalau waktu bisa diulang...
  - Key: 8
    Value: Kamu akan melakukan apa?
  - Key: 9
    Value: Mungkin aku nggak akan membiarkan kita berpisah begitu saja.
  - Key: 10
    Value: Aku juga sering memikirkan itu.
  - Key: 11
    Value: Kamu menyesal?
  - Key: 12
    Value: Kalau bilang nggak ada sama sekali, aku bohong.
  - Key: 13
    Value: Tapi semuanya sudah berubah sekarang.
  - Key: 14
    Value: Kita nggak bisa kembali ke masa itu.
  - Key: 15
    Value: Kalau begitu, kita bikin masa depan yang berbeda.
  - Key: 16
    Value: Maksudmu?
  - Key: 17
    Value: Aku nggak tahu...
  - Key: 18
    Value: Tapi kalau ada sesuatu yang dulu belum selesai,
  - Key: 19
    Value: Mungkin sekarang kita bisa menyelesaikannya.
  - Key: 20
    Value: Kamu yakin?
  - Key: 21
    Value: Aku nggak mau kehilangan kamu untuk kedua kalinya.
  - Key: 22
    Value: Untuk itu, jangan pergi lagi.
  - Key: 23
    Value: Iya..
  - Key: 24
    Value: Jadi... kita mulai dari sini?
  - Key: 25
    Value: ...
  - Key: 26
    Value: Pelan-pelan...
  - Key: 27
    Value: Tapi jangan saling meninggalkan lagi.
  - Key: 28
    Value: Yap. aku berjanji...
