  dialogueID: OnHome
  startingNodeIndex: 0
  nodes:
  - nodeID: 1
    speakerName: Reno
    dialogueText: I came home way too late tonight.
    nextNodeIndex: 1
  - nodeID: 2
    speakerName: Reno
    dialogueText: Looks like Raisha waited for me until she fell asleep.
    nextNodeIndex: 2
  - nodeID: 3
    speakerName: Reno
    dialogueText: I have to sneak quietly into the bedroom.
    nextNodeIndex: 3
  - nodeID: 4
    speakerName: Reno
    dialogueText: I mustn't wake her!
    nextNodeIndex: 4
