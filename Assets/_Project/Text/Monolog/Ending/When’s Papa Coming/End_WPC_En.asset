  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 53c49e862dc531140a76938cc94fa805, type: 3}
  m_Name: End_WPC_En
  m_EditorClassIdentifier: Assembly-CSharp::Game.Localization.LocalizationDatabase
  entries:
  - Key: 1
    Value: Hello?
  - Key: 2
    Value: Reno, I'm sorry. I wish I didn't have to tell you this over the phone.
  - Key: 3
    Value: What happened, ma'am?
  - Key: 4
    Value: Regarding the issue involving you and Hana, the company has conducted
      an investigation and review.
  - Key: 5
    Value: ...
  - Key: 6
    Value: After taking everything into consideration, we've decided to let you go,
      effective today.
  - Key: 7
    Value: Ma'am, wait. Please, just hear me out... I can explain...
  - Key: 8
    Value: The decision has already been made. We'll send you the official notice
      today.
  - Key: 9
    Value: Hana..
  - Key: 10
    Value: (No answer)
  - Key: 11
    Value: Mom, are we going to be here much longer?
  - Key: 12
    Value: Just a little longer.
  - Key: 13
    Value: Do you still miss Dad, Mom?
  - Key: 14
    Value: I do.
  - Key: 15
    Value: Dad must miss us too, right?
  - Key: 16
    Value: Maybe.
  - Key: 17
    Value: "Why did you say \u201Cmaybe\u201D?"
  - Key: 18
    Value: Because there are some things we'll never know.
  - Key: 19
    Value: But Dad promised he'd take me to that new amusement park...
  - Key: 20
    Value: Yes. I remember.
  - Key: 21
    Value: Then when is Dad coming home?
  - Key: 22
    Value: ...
  - Key: 23
    Value: "When\u2019s Papa"
  - Key: 24
    Value: Coming?
