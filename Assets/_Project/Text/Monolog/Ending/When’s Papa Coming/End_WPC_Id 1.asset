  m_Script: {fileID: 11500000, guid: 53c49e862dc531140a76938cc94fa805, type: 3}
  m_Name: End_WPC_Id 1
  m_EditorClassIdentifier: Assembly-CSharp::Game.Localization.LocalizationDatabase
  entries:
  - Key: 1
    Value: Aku pergi. Aku butuh waktu sendiri.
  - Key: 2
    Value: Sendiri? Atau kamu mau pergi ke dia?
  - Key: 3
    Value: Jangan bawa-bawa dia.
  - Key: 4
    Value: Kenapa? Bukankah selama ini dia yang selalu kamu cari?
  - Key: 5
    Value: Setidaknya dia masih mau mengerti aku.
  - Key: 6
    Value: Kalau begitu, pergilah.
  - Key: 7
    Value: ...
  - Key: 8
    Value: Tapi jangan datang kembali saat dia juga meninggalkanmu.
  - Key: 9
    Value: Aku nggak akan kembali.
