  m_Script: {fileID: 11500000, guid: 53c49e862dc531140a76938cc94fa805, type: 3}
  m_Name: End_WPC_En 1
  m_EditorClassIdentifier: Assembly-CSharp::Game.Localization.LocalizationDatabase
  entries:
  - Key: 1
    Value: I'm leaving. I need some time alone.
  - Key: 2
    Value: Alone? Or are you going to her?
  - Key: 3
    Value: Just leave her out of this.
  - Key: 4
    Value: Why? Aren't you the one who's been looking for her this whole time?
  - Key: 5
    Value: At least she actually tries to understand how I feel.
  - Key: 6
    Value: Fine. Then go.
  - Key: 7
    Value: ...
  - Key: 8
    Value: But don't come back here just because she ends up leaving you too.
  - Key: 9
    Value: I won't.
