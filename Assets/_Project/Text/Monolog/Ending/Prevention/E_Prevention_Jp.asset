  entries:
  - Key: 1
    Value: "\u8A71\u304C\u9577\u5F15\u3044\u3061\u3083\u3063\u3066\u3055\u3002\u3054\u3081\u3093\u3001\u9023\u7D61\u3059\u308B\u6642\u9593\u304C\u306A\u304B\u3063\u305F\u3002"
  - Key: 2
    Value: "\u5FC3\u914D\u3057\u305F\u3093\u3060\u3088\u3002\u6628\u65E5\u3060\u3063\u3066Rara\u3092\u8FCE\u3048\u306B\u884C\u3063\u3066\u304F\u308C\u306A\u304B\u3063\u305F\u3057\u3002"
  - Key: 3
    Value: "\u3046\u3093\u2026\u2026\u3042\u308C\u306F\u672C\u5F53\u306B\u3054\u3081\u3093\u3002\u5B8C\u5168\u306B\u4FFA\u306E\u843D\u3061\u5EA6\u3060\u3063\u305F\u3002"
  - Key: 4
    Value: "\u79C1\u3001Rara\u3092\u8FCE\u3048\u306B\u884C\u304F\u305F\u3081\u306B\u30AF\u30E9\u30A4\u30A2\u30F3\u30C8\u3068\u306E\u7D04\u675F\u307E\u3067\u30AD\u30E3\u30F3\u30BB\u30EB\u3057\u305F\u3093\u3060\u304B\u3089\u3002"
  - Key: 5
    Value: "\u308F\u304B\u3063\u3066\u308B\u3002\u672C\u5F53\u306A\u3089\u4FFA\u304C\u8FCE\u3048\u306B\u884C\u304F\u3079\u304D\u3060\u3063\u305F\u3002"
  - Key: 6
    Value: "\u79C1\u306F\u305F\u3060\u3001\u304C\u3063\u304B\u308A\u3057\u305F\u306E\u3002Reno\u306B\u305A\u3063\u3068\u6012\u3063\u3066\u3044\u305F\u3044\u308F\u3051\u3058\u3083\u306A\u3044\u3088\u3002"
  - Key: 7
    Value: "\u308F\u304B\u3063\u3066\u308B\u3002\u541B\u306B\u4F55\u3082\u304B\u3082\u4E00\u4EBA\u3067\u80CC\u8CA0\u308F\u305B\u305F\u304F\u3082\u306A\u3044\u3002"
  - Key: 8
    Value: "\u3082\u3046\u3044\u3044\u3088\u3002\u6B21\u304B\u3089\u306F\u3061\u3083\u3093\u3068\u9023\u7D61\u3057\u3066\u306D\u3002"
  - Key: 9
    Value: "\u3046\u3093\u3002\u7D04\u675F\u3059\u308B\u3002"
  - Key: 10
    Value: "\u3055\u3063\u304D\u306F\u3061\u3087\u3063\u3068\u611F\u60C5\u7684\u306B\u306A\u3063\u3061\u3083\u3063\u3066\u3001\u3054\u3081\u3093\u306D\u3002"
  - Key: 11
